<?xml version="1.0" encoding="UTF-8"?>
<Scenarios>
  <Scenario name="full-noweight" scenario_total_nodes="7" base_nodes="7">
    <ScenarioEditor>
      <BaseScenario filepath=""/>
      <!-- std-count + Switch + Hub, 无 Weight -->
      <section name="Node Information" base_nodes="7" density_count="7">
        <item selected="Router" v_metric="Count" v_count="2"/>
        <item selected="Switch" v_metric="Count" v_count="2"/>
        <item selected="Hub" v_metric="Count" v_count="1"/>
        <item selected="Workstation" v_metric="Count" v_count="5"/>
      </section>
      <section name="Routing" density="1.0">
        <item selected="OSPFv2" v_metric="Count" v_count="2"
              r2s_mode="Exact" r2s_edges="2"
              r2s_hosts_min="1" r2s_hosts_max="4"
              r2r_mode="Uniform" r2r_edges="1"/>
      </section>
      <section name="Services" density="1.0">
        <item selected="SSH" v_metric="Count" v_count="5"/>
        <item selected="DefaultRoute" v_metric="Count" v_count="5"/>
        <item selected="DHCP" v_metric="Count" v_count="1"/>
      </section>
      <section name="Events" density="0.5">
        <item selected="startup" script_path="scripts/startup.sh"/>
      </section>
      <section name="Vulnerabilities" density="0.5" explicit_count="1" derived_count="1" total_planned="2"
               weight_rows="1" count_rows="1" weight_sum="0.500">
        <item selected="Type/Vector" v_metric="Count" v_count="1" v_type="CVE" v_vector="remote"/>
        <item selected="Random" v_metric="Weight" factor="0.5"/>
      </section>
      <section name="Notes"><notes>full-noweight: Switch+Hub+全section, 无 Weight 双度量.</notes></section>
    </ScenarioEditor>
  </Scenario>
</Scenarios>
